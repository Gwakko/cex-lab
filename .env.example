# cex-lab configuration template. Copy to .env or .env.local and edit.
# Precedence (highest first): process environment, .env.local, .env.
# .env and .env.local are git-ignored; never commit real endpoints or keys.

# HTTP listen address for /metrics, /healthz, /readyz and /ws.
CEXLAB_HTTP_ADDR=127.0.0.1:0

# Logging: debug | info | warn | error, and json | text.
CEXLAB_LOG_LEVEL=info
CEXLAB_LOG_FORMAT=json

# Directory for the ledger journal and per-market command logs.
# Empty: the demo uses a temporary directory, other callers use memory.
CEXLAB_DATA_DIR=

# Markets: SYMBOL:BASE:QUOTE:TICK:LOT:MAKER_BPS:TAKER_BPS, comma separated.
# The demo scenario needs the BTC-USDT market below.
CEXLAB_MARKETS=BTC-USDT:BTC:USDT:1:100000:10:20

# Blocks required before a deposit is credited.
CEXLAB_CONFIRMATIONS=3

# EVM JSON-RPC endpoint. Empty: cmd/evmdemo starts its own anvil.
# cmd/evmdemo only accepts a loopback URL (it sends devnet transactions).
# Hosted RPC URLs often contain API keys: put them in .env.local only.
CEXLAB_EVM_RPC_URL=

# Deposit addresses to watch: 0xADDRESS=user, comma separated.
# Empty: cmd/evmdemo uses its built-in alice/bob addresses.
CEXLAB_WATCHED_ADDRESSES=

# Serve /metrics (metrics are recorded either way).
CEXLAB_METRICS_ENABLED=true

# Market data WebSocket limits.
CEXLAB_WS_MAX_CONNECTIONS=1000
CEXLAB_WS_QUEUE_SIZE=256
# Allowed cross-origin hosts, comma separated (e.g. example.com). Empty: same origin only.
CEXLAB_WS_ALLOWED_ORIGINS=
